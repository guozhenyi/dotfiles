{
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": [
    "JetBrains Mono",
    "IBM Plex Mono",
    "Source Code Pro",
    "Consolas",
    "monospace",
    "Microsoft YaHei",
    "sans-serif"
  ],
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 15,
  "line_ending": "prefer_lf",
  "ui_font_size": 16,

  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "disable_ai": true,
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",

  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "hover_popover_delay": 2000,
  "icon_theme": "Material Icon Theme",
  "minimap": {
    "show": "auto"
  },

  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "show_whitespaces": "boundary",
  "soft_wrap": "editor_width",

  "tab_size": 2,
  "terminal": {
    "font_size": 14.0
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },

  "wrap_guides": [80, 120]
}
